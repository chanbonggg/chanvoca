{
  "name": "@chanvoca/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps --env-file=.env dist/server.js",
    "migrate": "tsx --env-file=.env src/migrate.ts",
    "worker": "tsx --env-file=.env src/worker.ts",
    "vapid:generate": "tsx src/generate-vapid.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/modules/system/system.routes.test.ts src/modules/auth/auth.routes.test.ts src/modules/days/vocabulary-parser.test.ts src/modules/days/days.routes.integration.test.ts src/modules/study/review-plan.test.ts src/modules/examples/example-generator.test.ts src/modules/notifications/notifications.worker.test.ts src/modules/notifications/notifications.worker.integration.test.ts src/shared/logger.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.1",
    "fastify": "5.12.1",
    "postgres": "3.4.9",
    "web-push": "3.6.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "4.23.13",
    "typescript": "^5.9.0"
  }
}
